{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm fix)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(vp check)",
      "Bash(vp check *)",
      "Bash(vp test)",
      "Bash(vp test *)",
      "Bash(vp -C * test)",
      "Bash(vp -C * test *)",
      "Bash(vp -C * check)",
      "Bash(vp -C * check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
