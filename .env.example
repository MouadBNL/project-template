# Copy to .env (git-ignored). One file at the repo root serves every app.
# apps/api reads it in src/env.ts; apps/web reads it in vite.config.ts.

# Port the API listens on (apps/api). The web dev server proxies /rpc here.
API_PORT=3001

# Port of the web dev server (apps/web).
WEB_PORT=5173

# Database (apps/api). Unset: PGlite (Postgres in WASM) persisted in PGLITE_DATA_DIR,
# default <repo>/.data/pglite (git-ignored). Set to use a real Postgres server.
# DATABASE_URL=postgres://user:password@localhost:5432/app
# PGLITE_DATA_DIR=/absolute/path/to/pgdata   (a relative path is resolved from apps/api)
