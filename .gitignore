# Dependencies and caches (Vite+ task cache lives in node_modules/.vite)
node_modules

# Build output
dist
*.tsbuildinfo

# Local database (PGlite data directory used by `pnpm dev`)
.data

# Environment: copy .env.example to .env
.env
.env.*
!.env.example

# Logs
*.log

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store

# AI agent worktrees
.claude/worktrees/

# TanStack Router generator scratch files
.tanstack

# Playwright output (e2e/): traces and screenshots of failed journeys, HTML report
e2e/test-results
e2e/playwright-report

# Vitest failure attachments
.vitest

# Git hook shims, generated by `vp install` (vp config); the hook itself is .vite-hooks/pre-commit
.vite-hooks/_
